# Copy outside the repository to /etc/ottv2.env; do not commit real secrets.
ARENA_DATA=/var/lib/ottv2
ARENA_ORIGIN=https://arena.example.org
ARENA_REGISTRATION_CODE=replace-with-a-long-random-invite
ARENA_BOT_IMAGE=ottv2-bot:1
# Only enable with the API bound to loopback and reached through cloudflared.
ARENA_TRUST_CLOUDFLARE=1
PYTHONUTF8=1
