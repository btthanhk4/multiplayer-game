# Copy outside the repository to /etc/ottv2.env; do not commit real secrets.
ARENA_DATA=/var/lib/ottv2
ARENA_ORIGIN=https://arena.example.org
ARENA_REGISTRATION_CODE=replace-with-a-long-random-invite
ARENA_BOT_IMAGE=ottv2-bot:1
# Games graded in parallel by one runner: about one per free CPU core (each bot gets --cpus=1, 256 MiB).
ARENA_RUNNER_SLOTS=8
# Web server threads and open connections.
ARENA_THREADS=16
ARENA_CONNECTIONS=1000
ARENA_TEAM_SIZE=4
ARENA_SESSION_DAYS=7
# Per-IP limits stay generous because a whole campus can share one NAT address.
# ARENA_RATE_REGISTER_IP=3000
# ARENA_RATE_LOGIN_IP=10000
# ARENA_RATE_LOGIN_USER=20
# ARENA_RATE_SUBMIT_TEAM=20
# ARENA_RATE_CAMPAIGN_TEAM=30
# Only enable with the API bound to loopback and reached through cloudflared.
ARENA_TRUST_CLOUDFLARE=1
PYTHONUTF8=1
